+    try {
+      // Some Chromium browsers expose tabGroups but leave its promises pending.
+      // Probe only a read: timing out group recovery itself could let late tab
+      // moves or grouping mutations run after startup has already continued.
+      const groups = await Promise.race([
+        Promise.resolve().then(() => chrome.tabGroups.query({ title: CONTAINER_TAB_GROUP_TITLE.interactive })),
+        new Promise<never>((_resolve, reject) => {
+          timer = setTimeout(() => reject(new Error('Tab group probe timed out')), OWNED_GROUP_PROBE_TIMEOUT_MS);
+        }),
+      ]);
+      return Array.isArray(groups);
+    } catch {
+      console.warn('[opencli] Tab grouping unavailable; using ungrouped owned tabs');
+      return false;
+    } finally {
+      if (timer !== undefined) clearTimeout(timer);
+    }
+  })();
+  // Cache the race result, so a late probe response cannot enable grouping in
+  // this worker after the ungrouped ownership path has been selected.
+  return ownedGroupSupport;
