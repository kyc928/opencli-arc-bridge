+const OWNED_GROUP_PROBE_TIMEOUT_MS = 1500;
+let ownedGroupSupport: Promise<boolean> | null = null;
+
+function supportsOwnedContainerGroups(): Promise<boolean> {
+  if (ownedGroupSupport) return ownedGroupSupport;
+  ownedGroupSupport = (async () => {
+    if (
+      typeof chrome.tabGroups?.query !== 'function' ||
+      typeof chrome.tabGroups?.get !== 'function' ||
+      typeof chrome.tabGroups?.update !== 'function' ||
+      typeof chrome.tabs.group !== 'function'
